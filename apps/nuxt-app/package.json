{
  "name": "nuxt-app",
  "version": "4.1.8-beta.3",
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "build:only": "nuxi build",
    "preview": "nuxi preview",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:js": "cross-env NODE_ENV=production eslint --fix .",
    "lint:style": "stylelint --fix \"**/*.{vue,css,scss,postcss,pcss}\"",
    "types:check": "nuxi typecheck"
  },
  "dependencies": {
    "@maz-ui/icons": "workspace:*",
    "@maz-ui/nuxt": "workspace:*",
    "@maz-ui/utils": "workspace:*",
    "maz-ui": "workspace:*",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@maz-ui/stylelint-config": "workspace:*",
    "@nuxt/devtools": "^4.0.0-beta.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "nuxt": "^4.5.2",
    "postcss-nested": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "vue-router": "^5.3.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix",
    "*.{vue,css,scss,postcss,pcss}": "stylelint --fix"
  }
