import { createHash } from 'node:crypto'
import { existsSync } from 'node:fs'
import { copyFile, mkdir, readFile, writeFile } from 'node:fs/promises'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const _dirname = dirname(fileURLToPath(import.meta.url))

/** Skills published for the agents, generated by `pnpm -F agent-docs generate:plugin` */
const skills = [
  {
    name: 'maz-ui',
    source: join(_dirname, '../../../../plugins/claude-code/skills/maz-ui/SKILL.md'),
  },
]

const SKILLS_DIR = '.well-known/agent-skills'

function getDescription(skill: string): string {
  const description = /^description:\s*"(.+)"\s*$/m.exec(skill)?.[1]
  if (!description)
    throw new Error('[docs] a published SKILL.md has no `description` in its frontmatter')
  return description
}

/**
 * Agent Skills discovery (https://github.com/cloudflare/agent-skills-discovery-rfc):
 * `/.well-known/agent-skills/index.json` lists the skills, each one served next to it
 */
export async function writeAgentSkills(outDir: string): Promise<void> {
  const entries = await Promise.all(skills.map(async ({ name, source }) => {
    const content = await readFile(source)
    const path = `${SKILLS_DIR}/${name}/SKILL.md`

    await mkdir(join(outDir, dirname(path)), { recursive: true })
    await writeFile(join(outDir, path), content)

    return {
      name,
      type: 'skill-md',
      description: getDescription(content.toString('utf8')),
      url: `/${path}`,
      digest: `sha256:${createHash('sha256').update(content).digest('hex')}`,
    }
  }))

  await writeFile(
    join(outDir, SKILLS_DIR, 'index.json'),
    `${JSON.stringify({ $schema: 'https://schemas.agentskills.io/discovery/0.2.0/schema.json', skills: entries }, null, 2)}\n`,
  )
}

/**
 * Markdown version of the home page, served for `Accept: text/markdown` (see the `.htaccess`):
 * the `llms.txt` index of the docs
 */
export async function writeHomeMarkdown(outDir: string): Promise<void> {
  const home = join(outDir, 'index.md')
  const llms = join(outDir, 'llms.txt')
  if (existsSync(home) || !existsSync(llms))
    return
  await copyFile(llms, home)
}
