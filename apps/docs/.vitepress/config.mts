import type { Plugin } from 'postcss'
import type { DefaultTheme, HeadConfig } from 'vitepress'
import { existsSync } from 'node:fs'
import { cp, writeFile } from 'node:fs/promises'
import { createRequire } from 'node:module'
import { dirname, join } from 'node:path'
import process from 'node:process'
import { fileURLToPath } from 'node:url'

import { CSS_ID, generateCSS, mergePresets } from '@maz-ui/themes/utils'
import { VitePreNestedCss } from '@maz-ui/vite-config'
import tailwindcss from '@tailwindcss/vite'
import { MazComponentsResolver } from 'maz-ui/resolvers'
import postcssUrl from 'postcss-url'
import Components from 'unplugin-vue-components/vite'
import { defaultClientConditions } from 'vite'
import svgLoader from 'vite-svg-loader'
import { defineConfig, postcssIsolateStyles } from 'vitepress'
import { getHtaccess, head, nav, redirectMiddleware, sidebar, writeAgentSkills, writeHomeMarkdown } from './configs/index.mjs'
import { getOgImage } from './og-image.tsx'
import { DOCS_THEME } from './theme/theme-options.ts'

// VitePress sets NODE_ENV=development for `vitepress dev` and =production
// for `vitepress build`. Use that to toggle the `monorepo:dev` resolve
// condition so dev loads maz-ui src/ with HMR and prod consumes the dist.
const isDev = process.env.NODE_ENV !== 'production'
const isNextEnv = process.env.DEPLOY_ENV === 'next'

const _dirname = dirname(fileURLToPath(import.meta.url))
const require = createRequire(import.meta.url)
const { version } = require('maz-ui/package.json') as { version: string }

const SITE_URL = 'https://maz-ui.com'
// llms.txt, llms-full.txt and the markdown version of each page, generated by `pnpm generate:docs`
const agentDocs = join(_dirname, 'agent-docs')
const author = { '@type': 'Person', 'name': 'Loïc Mazuel', 'url': 'https://github.com/LouisMazel' }

const homeStructuredData: HeadConfig[] = [
  [
    'script',
    { type: 'application/ld+json' },
    JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'Maz-UI',
      'url': SITE_URL,
      'description': 'Vue 3 and Nuxt component library with themes, icons, translations and AI tooling',
      author,
    }),
  ],
  [
    'script',
    { type: 'application/ld+json' },
    JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      'name': 'Maz-UI',
      'description': 'Standalone Vue 3 and Nuxt components, composables, directives and plugins, with packages for themes, icons, translations, helpers and AI agents.',
      'url': SITE_URL,
      'codeRepository': 'https://github.com/LouisMazel/maz-ui',
      'programmingLanguage': ['TypeScript', 'Vue'],
      'runtimePlatform': ['Vue 3', 'Nuxt'],
      'version': version,
      'license': 'https://opensource.org/licenses/MIT',
      'sameAs': ['https://github.com/LouisMazel/maz-ui', 'https://www.npmjs.com/package/maz-ui'],
      author,
    }),
  ],
]

function pascalCaseToKebabCase(value: string): string {
  return value.replaceAll(/([\da-z])([A-Z])/g, '$1-$2').toLowerCase()
}

function getAssetBaseUrl(path: string): string {
  const base = process.env.NODE_ENV === 'production'
    ? 'https://maz-ui.com'
    : ''
  return `${base}${path}`
}

export default defineConfig<DefaultTheme.Config>({
  srcDir: 'src',
  lang: 'en-US',
  title: 'Maz-UI',
  titleTemplate: ':title | Maz-UI',
  description: 'Library of standalone components and tools for Vue & Nuxt',

  lastUpdated: true,
  cleanUrls: true,

  markdown: {
    image: {
      lazyLoad: true,
    },
    // Dark in both modes on purpose: the code blocks stay dark on the light site (`--vp-code-block-bg` in theme/main.css)
    theme: {
      light: 'github-dark',
      dark: 'tokyo-night',
    },
  },

  sitemap: isNextEnv
    ? undefined
    : {
        hostname: 'https://maz-ui.com/',
        transformItems: (items) => {
          // add new items or modify/filter existing items
          const modifyItems: typeof items = []

          for (const item of items) {
            if (item.url.includes('404')) {
              continue
            }
            modifyItems.push({
              ...item,
              changefreq: 'daily',
              priority: 1,
            })
          }

          return modifyItems
        },
      },

  async buildEnd(siteConfig) {
    if (isNextEnv) {
      await writeFile(join(siteConfig.outDir, 'robots.txt'), 'User-agent: *\nDisallow: /\n')
    }

    if (!isNextEnv) {
      await writeFile(join(siteConfig.outDir, '.htaccess'), getHtaccess())
    }

    if (existsSync(agentDocs)) {
      await cp(agentDocs, siteConfig.outDir, { recursive: true })
    }

    await writeHomeMarkdown(siteConfig.outDir)
    await writeAgentSkills(siteConfig.outDir)
  },

  head: [
    ...head,
    // The CSS of the preset is in the static HTML: no flash before the app injects it at runtime (same `id`, so it reuses this tag)
    [
      'style',
      { id: CSS_ID },
      generateCSS(mergePresets(DOCS_THEME.preset, DOCS_THEME.overrides), {
        mode: 'both',
        darkSelectorStrategy: DOCS_THEME.darkModeStrategy,
        darkClass: 'dark',
        lightClass: 'light',
      }),
    ],
  ],

  themeConfig: {
    siteTitle: 'Maz-UI',

    logo: { src: '/img/logo-linear.svg', alt: 'Maz-UI logo' },
    sidebar,
    nav,
    socialLinks: [
      { icon: 'github', link: 'https://github.com/LouisMazel/maz-ui' },
      { icon: 'twitter', link: 'https://twitter.com/maz__ui' },
      { icon: 'npm', link: 'https://www.npmjs.com/package/maz-ui' },
    ],
    outline: {
      level: [2, 3],
    },
    externalLinkIcon: true,
    lastUpdated: {
      formatOptions: {
        dateStyle: 'medium',
      },
    },
    editLink: {
      pattern: 'https://github.com/LouisMazel/maz-ui/edit/master/apps/docs/src/:path',
      text: 'Edit this page on GitHub',
    },

    search: {
      provider: 'algolia',
      options: {
        appId: '4ML7HKE73Z',
        apiKey: 'a98bd8a34144a39eb5c59898582e093f',
        indexName: 'maz-ui-3',
      },
    },
  },

  vite: {
    // Resolve `monorepo:dev` first when developing so we consume maz-ui's
    // raw src/ (with HMR), and fall back to the published dist for prod builds.
    resolve: {
      conditions: isDev
        ? ['monorepo:dev', ...defaultClientConditions]
        : [...defaultClientConditions],
    },
    build: {
      rolldownOptions: {
        external: ['node:child_process', 'colorette'],
      },
      target: 'esnext',
      chunkSizeWarningLimit: 1000,
    },
    ssr: {
      noExternal: ['dayjs'],
    },
    plugins: [
      ...(isDev
        ? [
            VitePreNestedCss(),
          ]
        : []),
      tailwindcss(),
      svgLoader(),
      {
        // A page named like its component (maz-btn.md) compiles `<MazBtn>` to a self reference that the resolver skips
        name: 'docs:maz-self-reference',
        enforce: 'post',
        transform(code, id) {
          if (/\.md(?:$|\?vue)/.test(id))
            return code.replaceAll(/(_?resolveComponent\d*)\("(Maz\w+)",\s*(?:true|!0)\)/g, '$1("$2")')
        },
      },
      Components({
        dirs: [],
        include: [
          /\.vue$/,
          /\.vue\?vue/,
          /\.md$/,
          /\.md\?vue/,
        ],
        resolvers: [
          MazComponentsResolver(),
        ],
        dts: false,
      }),
      {
        name: 'docs:redirects',
        configureServer(server) {
          server.middlewares.use(redirectMiddleware)
        },
      },
    ],
    css: {
      postcss: {
        plugins: [
          postcssUrl() as Plugin,
          postcssIsolateStyles({
            includeFiles: [/vp-doc\.css/],
          }),
        ],
      },
    },
  },

  transformHead: async ({ siteData, pageData, title, description, head }) => {
    const currentTitle = title ?? pageData.title ?? pageData.frontmatter.title ?? siteData.title
    const currentDescription = description ?? pageData.frontmatter.description ?? pageData.description ?? siteData.description

    const currentUrl = getAssetBaseUrl(`/${pageData.relativePath.replace(/(^|\/)index\.md$/, '$1').replace(/\.md$/, '')}`)

    const ogImageFilename = pascalCaseToKebabCase(currentTitle.split(' ')[0].replace(' | Maz-UI', '').replaceAll(' ', '').replace('/', '-'))
    const outputDistFolder = '/og-images'
    const imagePublicPath = `${outputDistFolder}/${ogImageFilename}.png`

    let image: string | undefined

    if (process.env.TEST_ENV !== 'true') {
      image = await getOgImage({
        outputFolder: join(_dirname, `./dist`, outputDistFolder),
        filename: ogImageFilename,
        title: currentTitle,
        description: currentDescription,
      })
    }

    const ogImage = image
      ? getAssetBaseUrl(imagePublicPath)
      : getAssetBaseUrl('/img/maz-ui-preview.jpg')

    const pageHead: HeadConfig[] = [
      [
        'meta',
        { property: 'og:title', content: currentTitle },
      ],
      [
        'link',
        { rel: 'canonical', href: currentUrl },
      ],
      [
        'meta',
        { property: 'og:url', content: currentUrl },
      ],
      [
        'meta',
        {
          property: 'og:type',
          content: pageData.relativePath === 'index.md'
            ? 'website'
            : 'article',
        },
      ],
      [
        'meta',
        { name: 'description', content: currentDescription },
      ],
      [
        'meta',
        { property: 'og:description', content: currentDescription },
      ],
      [
        'meta',
        { name: 'twitter:title', content: currentTitle },
      ],
      [
        'meta',
        { name: 'twitter:image', content: ogImage },
      ],
      [
        'meta',
        { name: 'twitter:description', content: currentDescription },
      ],
      [
        'meta',
        { name: 'twitter:image:alt', content: currentDescription },
      ],
      [
        'meta',
        { property: 'og:image', content: ogImage },
      ],
      [
        'meta',
        { property: 'og:image:alt', content: currentDescription },
      ],
      [
        'meta',
        {
          property: 'og:updated_time',
          content: pageData.lastUpdated
            ? new Date(pageData.lastUpdated).toISOString()
            : new Date().toISOString(),
        },
      ],
      [
        'meta',
        {
          property: 'article:modified_time',
          content: pageData.lastUpdated
            ? new Date(pageData.lastUpdated).toISOString()
            : new Date().toISOString(),
        },
      ],
    ]

    if (existsSync(join(agentDocs, pageData.relativePath))) {
      pageHead.push([
        'link',
        {
          rel: 'alternate',
          type: 'text/markdown',
          href: getAssetBaseUrl(`/${pageData.relativePath}`),
        },
      ])
    }

    if (existsSync(join(agentDocs, 'llms.txt'))) {
      pageHead.push([
        'link',
        {
          rel: 'describedby',
          href: getAssetBaseUrl('/llms.txt'),
        },
      ])
    }

    if (pageData.relativePath === 'index.md') {
      pageHead.push(...homeStructuredData)
    }

    return [
      ...head,
      ...pageHead,
    ]
  },
})
