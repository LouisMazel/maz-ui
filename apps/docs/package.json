{
  "name": "docs",
  "type": "module",
  "version": "4.1.8-beta.3",
  "private": true,
  "description": "documentation of maz-ui",
  "author": "LouisMazel <me@loicmazuel.com>",
  "license": "ISC",
  "scripts": {
    "dev": "vitepress dev",
    "build": "pnpm generate:docs && vitepress build",
    "generate:components-docs": "tsx ../../tools/agent-docs/src/cli.ts --vitepress ./.vitepress/generated-docs",
    "build:test": "cross-env TEST_ENV=true pnpm build",
    "build:watch": "pnpm build:test --watch",
    "preview": "vitepress preview",
    "serve": "vitepress serve",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "ftp-deploy:dev": "cross-env DEPLOY_ENV=next node ./ftp-deploy.mjs",
    "ftp-deploy": "node ./ftp-deploy.mjs",
    "types:check": "vue-tsc --noEmit --skipLibCheck",
    "generate:docs": "tsx ../../tools/agent-docs/src/cli.ts --vitepress ./.vitepress/generated-docs --site ./.vitepress/agent-docs"
  },
  "dependencies": {
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/icons": "workspace:^",
    "@maz-ui/node": "workspace:^",
    "@maz-ui/themes": "workspace:^",
    "@maz-ui/translations": "workspace:^",
    "@maz-ui/utils": "workspace:^",
    "chart.js": "^4.6.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dayjs": "^1.11.23",
    "libphonenumber-js": "^1.13.15",
    "maz-ui": "workspace:^",
    "shiki": "^4.6.0",
    "valibot": "^1.5.0",
    "vitepress-plugin-google-analytics": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@maz-ui/vite-config": "workspace:^",
    "@samkirkland/ftp-deploy": "^1.2.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/postcss-url": "^10.0.4",
    "@types/react": "^19.3.0",
    "@vercel/og": "^0.11.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "postcss": "^8.5.32",
    "postcss-nested": "^9.0.1",
    "postcss-url": "^10.1.4",
    "react": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.44",
    "vue-tsc": "3.3.14"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/docs/src/**/*.md",
          "{workspaceRoot}/apps/docs/.vitepress/mixins/**/*",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/packages/lib/src/**/*",
          "{workspaceRoot}/packages/icons/src/icon-list.ts",
          "{workspaceRoot}/packages/nuxt/src/module.ts",
          "{workspaceRoot}/packages/utils/src/**/*",
          "{workspaceRoot}/packages/node/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/.vitepress/dist",
          "{projectRoot}/.vitepress/agent-docs"
        ]
      }
    }
  }
}
