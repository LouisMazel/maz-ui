{
  "name": "root",
  "version": "5.3.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "A standalone components library for Vue.Js & Nuxt.Js",
  "author": "LouisMazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://maz-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/LouisMazel/maz-ui/issues"
  },
  "keywords": [
    "vue",
    "components",
    "vue-component",
    "framework",
    "library",
    "ui"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "make clean",
    "clean:output": "make clean-output",
    "postinstall": "nx run-many -t build -p @maz-ui/node @maz-ui/utils @maz-ui/icons @maz-ui/themes @maz-ui/cli @maz-ui/eslint-config @maz-ui/stylelint-config && nx run @maz-ui/nuxt:dev",
    "prepare": "npx husky",
    "pre-commit": "lint-staged",
    "build:all": "nx run-many -t build",
    "build:apps": "nx run-many -t build -p docs nuxt-app vue-app",
    "build:utils": "nx run-many -t build -p @maz-ui/node @maz-ui/utils",
    "build:packages": "nx run-many -t build -p '@maz-ui/*' maz-ui",
    "build:packages:test": "nx run-many -t build -p @maz-ui/translations @maz-ui/icons @maz-ui/node @maz-ui/utils",
    "lint": "cross-env NODE_ENV=production eslint",
    "lint:fix": "cross-env NODE_ENV=production eslint --fix",
    "lint:all": "nx run-many -t lint",
    "lint:fix:all": "nx run-many -t lint:fix",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "nx run-many -t typecheck",
    "test:unit:all": "nx run-many -t test:unit",
    "test:unit:coverage:all": "nx run-many -t test:unit:coverage",
    "health": "nx run-many -t lint:fix typecheck test:unit:coverage build -p '@maz-ui/*' maz-ui",
    "nx:cache:clear": "nx reset",
    "dev:watch": "nx run-many -t dev",
    "yolo": "yolo",
    "maz:upgrade": "node ./packages/upgrade/dist/cli.mjs"
  },
  "devDependencies": {
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/mcp": "workspace:^",
    "@maz-ui/node": "workspace:^",
    "@types/node": "catalog:",
    "@yoloship/action": "0.2.0-beta.15",
    "@yoloship/claude-sdk": "0.2.0-beta.9",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "nx": "^24.0.4",
    "relizy": "2.0.1",
    "semver": "^7.8.6",
    "twitter-api-v2": "^1.31.0",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,md,yml,json}": [
      "eslint --fix"
    ]
  },
  "nx": {}
}
