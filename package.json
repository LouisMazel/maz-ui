{
  "name": "root",
  "version": "5.0.0-beta.17",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "description": "A standalone components library for Vue.Js & Nuxt.Js",
  "author": "LouisMazel <me@loicmazuel.com>",
  "license": "ISC",
  "homepage": "https://maz-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/LouisMazel/maz-ui/issues"
  },
  "keywords": [
    "vue",
    "components",
    "vue-component",
    "framework",
    "library",
    "ui"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clean": "make clean",
    "postinstall": "nx run-many -t codegen",
    "prepare": "npx husky",
    "pre-commit": "lint-staged",
    "commit": "cz",
    "build:all": "nx run-many -t build",
    "build:apps": "nx run-many -t build -p docs nuxt-app vue-app",
    "build:utils": "nx run-many -t build -p @maz-ui/node @maz-ui/utils",
    "build:packages": "nx run-many -t build -p '@maz-ui/*' maz-ui",
    "build:packages:test": "nx run-many -t build -p @maz-ui/translations @maz-ui/icons @maz-ui/node @maz-ui/utils",
    "lint": "cross-env NODE_ENV=production eslint",
    "lint:fix": "cross-env NODE_ENV=production eslint --fix",
    "lint:all": "nx run-many -t lint",
    "lint:fix:all": "nx run-many -t lint:fix",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "nx run-many -t typecheck",
    "test:unit:all": "nx run-many -t test:unit",
    "test:unit:coverage:all": "nx run-many -t test:unit:coverage",
    "health": "nx run-many -t lint:fix typecheck test:unit:coverage build --parallel=100% -p '@maz-ui/*' maz-ui",
    "relizy": "relizy",
    "nx:cache:clear": "nx reset",
    "dev:watch": "nx run-many -t dev",
    "yolo": "yolo"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/cz-commitlint": "^21.0.1",
    "@maz-ui/eslint-config": "workspace:*",
    "@maz-ui/node": "workspace:*",
    "@nx/js": "^22.7.2",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "@yoloship/action": "0.2.0-beta.7",
    "@yoloship/claude-sdk": "0.2.0-beta.5",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "17.0.5",
    "nx": "^22.7.2",
    "postcss": "^8.5.15",
    "postcss-nested": "^7.0.2",
    "postcss-url": "^10.1.3",
    "relizy": "1.4.5",
    "semver": "^7.8.0",
    "stylelint": "^17.11.1",
    "tsx": "^4.22.3",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-svg-loader": "^5.1.1",
    "vitest": "4.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,md,yml,json}": [
      "eslint --fix"
    ]
  }
}
