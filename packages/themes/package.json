{
  "name": "@maz-ui/themes",
  "type": "module",
  "version": "5.9.0-beta.1",
  "description": "Theme system for Maz-UI with TypeScript support and CSS variables",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://maz-ui.com/ecosystem/themes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": "https://github.com/LouisMazel/maz-ui/issues",
  "keywords": [
    "vue",
    "theme",
    "css-variables",
    "typescript",
    "maz-ui"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./presets": {
        "types": "./dist/presets/index.d.mts",
        "import": "./dist/presets/index.js",
        "default": "./dist/presets/index.js"
      },
      "./presets/*": {
        "types": "./dist/presets/*.d.mts",
        "import": "./dist/presets/*.js",
        "default": "./dist/presets/*.js"
      },
      "./composables": {
        "types": "./dist/composables/index.d.mts",
        "import": "./dist/composables/index.js",
        "default": "./dist/composables/index.js"
      },
      "./composables/*": {
        "types": "./dist/composables/*.d.mts",
        "import": "./dist/composables/*.js",
        "default": "./dist/composables/*.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.mts",
        "import": "./dist/utils/index.js",
        "default": "./dist/utils/index.js"
      },
      "./utils/*": {
        "types": "./dist/utils/*.d.mts",
        "import": "./dist/utils/*.js",
        "default": "./dist/utils/*.js"
      },
      "./build": {
        "types": "./dist/build/index.d.mts",
        "import": "./dist/build/index.js",
        "default": "./dist/build/index.js"
      },
      "./build/*": {
        "types": "./dist/build/*.d.mts",
        "import": "./dist/build/*.js",
        "default": "./dist/build/*.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.mts",
        "import": "./dist/plugin.js",
        "default": "./dist/plugin.js"
      }
    }
  },
  "exports": {
    ".": {
      "monorepo:dev": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./presets": {
      "monorepo:dev": "./src/presets/index.ts",
      "types": "./dist/presets/index.d.mts",
      "import": "./dist/presets/index.js",
      "default": "./dist/presets/index.js"
    },
    "./presets/*": {
      "monorepo:dev": "./src/presets/*.ts",
      "types": "./dist/presets/*.d.mts",
      "import": "./dist/presets/*.js",
      "default": "./dist/presets/*.js"
    },
    "./composables": {
      "monorepo:dev": "./src/composables/index.ts",
      "types": "./dist/composables/index.d.mts",
      "import": "./dist/composables/index.js",
      "default": "./dist/composables/index.js"
    },
    "./composables/*": {
      "monorepo:dev": "./src/composables/*.ts",
      "types": "./dist/composables/*.d.mts",
      "import": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    },
    "./utils": {
      "monorepo:dev": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "monorepo:dev": "./src/utils/*.ts",
      "types": "./dist/utils/*.d.mts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./build": {
      "monorepo:dev": "./src/build/index.ts",
      "types": "./dist/build/index.d.mts",
      "import": "./dist/build/index.js",
      "default": "./dist/build/index.js"
    },
    "./build/*": {
      "monorepo:dev": "./src/build/*.ts",
      "types": "./dist/build/*.d.mts",
      "import": "./dist/build/*.js",
      "default": "./dist/build/*.js"
    },
    "./plugin": {
      "monorepo:dev": "./src/plugin.ts",
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "vite build && pnpm generate:agent-docs",
    "generate:agent-docs": "pnpm -F agent-docs generate --package @maz-ui/themes",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "check:published-types": "attw --pack . --profile esm-only",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:coverage:watch": "vitest watch --coverage",
    "test:unit:coverage:master": "vitest run --coverage --changed master"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4.0.0"
  },
  "dependencies": {
    "@maz-ui/utils": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@codecov/vite-plugin": "catalog:",
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/vite-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/apps/docs/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/agent-docs"
        ]
      }
    }
  }
}
