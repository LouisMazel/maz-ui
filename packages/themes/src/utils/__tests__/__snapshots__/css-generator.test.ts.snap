    --maz-shadow-50: oklch(from var(--maz-shadow) clamp(0, calc(l + 0.42), 1) calc(c * 0.1) h);
    --maz-shadow-100: oklch(from var(--maz-shadow) clamp(0, calc(l + 0.35), 1) calc(c * 0.3) h);
    --maz-shadow-200: oklch(from var(--maz-shadow) clamp(0, calc(l + 0.26), 1) calc(c * 0.6) h);
    --maz-shadow-300: oklch(from var(--maz-shadow) clamp(0, calc(l + 0.17), 1) calc(c * 0.85) h);
    --maz-shadow-400: oklch(from var(--maz-shadow) clamp(0, calc(l + 0.08), 1) c h);
    --maz-shadow-500: var(--maz-shadow);
    --maz-shadow-600: oklch(from var(--maz-shadow) clamp(0, calc(l - 0.07), 1) c h);
    --maz-shadow-700: oklch(from var(--maz-shadow) clamp(0, calc(l - 0.14), 1) c h);
    --maz-shadow-800: oklch(from var(--maz-shadow) clamp(0, calc(l - 0.21), 1) calc(c * 0.85) h);
    --maz-shadow-900: oklch(from var(--maz-shadow) clamp(0, calc(l - 0.28), 1) calc(c * 0.65) h);
    --maz-shadow-950: oklch(from var(--maz-shadow) clamp(0, calc(l - 0.34), 1) calc(c * 0.45) h);
  }
  .dark { color-scheme: only dark; }
  .light { color-scheme: only light; }
}"
`;
