{
  "name": "@maz-ui/utils",
  "type": "module",
  "version": "5.5.0",
  "description": "Utils of maz-ui for JavaScript/TypeScript users",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": "https://github.com/LouisMazel/maz-ui/issues",
  "keywords": [
    "utils",
    "javascript",
    "typescript",
    "maz-ui"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "monorepo:dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "monorepo:dev": "./src/helpers/index.ts",
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js",
      "module": "./dist/helpers/index.js",
      "default": "./dist/helpers/index.js"
    },
    "./helpers/*": {
      "monorepo:dev": "./src/helpers/*.ts",
      "types": "./dist/helpers/*.d.ts",
      "import": "./dist/helpers/*.js",
      "module": "./dist/helpers/*.js",
      "default": "./dist/helpers/*.js"
    },
    "./ts-helpers": {
      "monorepo:dev": "./src/ts-helpers/index.ts",
      "types": "./dist/ts-helpers/index.d.ts"
    },
    "./ts-helpers/*": {
      "monorepo:dev": "./src/ts-helpers/*.ts",
      "types": "./dist/ts-helpers/*.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "vite build && pnpm generate:agent-docs",
    "generate:agent-docs": "pnpm -F agent-docs generate --package @maz-ui/utils",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "libphonenumber-js": ">= 1 < 2",
    "vue": ">=3.5.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "libphonenumber-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codecov/vite-plugin": "catalog:",
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/vite-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "libphonenumber-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,md,yml,json}": [
      "eslint --fix"
    ]
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/apps/docs/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/agent-docs"
        ]
      }
    }
  }
}
