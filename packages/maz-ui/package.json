{
  "name": "maz-ui",
  "type": "module",
  "version": "5.5.0",
  "description": "A standalone components library for Vue.Js 3 & Nuxt.Js 3",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://maz-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/LouisMazel/maz-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "components",
    "vue-component",
    "framework",
    "library",
    "ui",
    "nuxt3",
    "module",
    "nuxt-module"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/css/**"
  ],
  "exports": {
    ".": {
      "monorepo:dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "monorepo:dev": "./src/components/index.ts",
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "module": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/*": {
      "monorepo:dev": "./src/components/*.vue",
      "types": "./dist/components/*.vue.d.ts",
      "import": "./dist/components/*.js",
      "module": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./composables": {
      "monorepo:dev": "./src/composables/index.ts",
      "types": "./dist/composables/index.d.ts",
      "import": "./dist/composables/index.js",
      "module": "./dist/composables/index.js",
      "default": "./dist/composables/index.js"
    },
    "./composables/*": {
      "monorepo:dev": "./src/composables/*.ts",
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js",
      "module": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    },
    "./plugins": {
      "monorepo:dev": "./src/plugins/index.ts",
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js",
      "module": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./plugins/*": {
      "monorepo:dev": "./src/plugins/*.ts",
      "types": "./dist/plugins/*.d.ts",
      "import": "./dist/plugins/*.js",
      "module": "./dist/plugins/*.js",
      "default": "./dist/plugins/*.js"
    },
    "./directives": {
      "monorepo:dev": "./src/directives/index.ts",
      "types": "./dist/directives/index.d.ts",
      "import": "./dist/directives/index.js",
      "module": "./dist/directives/index.js",
      "default": "./dist/directives/index.js"
    },
    "./directives/*": {
      "monorepo:dev": "./src/directives/*.ts",
      "types": "./dist/directives/*.d.ts",
      "import": "./dist/directives/*.js",
      "module": "./dist/directives/*.js",
      "default": "./dist/directives/*.js"
    },
    "./resolvers": {
      "monorepo:dev": "./src/resolvers/index.ts",
      "types": "./dist/resolvers/index.d.ts",
      "import": "./dist/resolvers/index.js",
      "module": "./dist/resolvers/index.js",
      "default": "./dist/resolvers/index.js"
    },
    "./resolvers/*": {
      "monorepo:dev": "./src/resolvers/*.ts",
      "types": "./dist/resolvers/*.d.ts",
      "import": "./dist/resolvers/*.js",
      "module": "./dist/resolvers/*.js",
      "default": "./dist/resolvers/*.js"
    },
    "./country-flags": {
      "monorepo:dev": "./src/utils/country-flags.ts",
      "types": "./dist/utils/country-flags.d.ts",
      "import": "./dist/country-flags.js",
      "module": "./dist/country-flags.js",
      "default": "./dist/country-flags.js"
    },
    "./tailwindcss": {
      "monorepo:dev": "./src/tailwindcss/index.ts",
      "types": "./dist/tailwindcss/index.d.ts",
      "import": "./dist/tailwindcss/index.js",
      "module": "./dist/tailwindcss/index.js",
      "default": "./dist/tailwindcss/index.js"
    },
    "./tailwindcss/theme.css": "./src/tailwindcss/theme.css",
    "./tailwindcss/theme-colors.css": "./src/tailwindcss/theme-colors.css",
    "./tailwindcss/theme-components.css": "./src/tailwindcss/theme-components.css",
    "./tailwindcss/theme-radius.css": "./src/tailwindcss/theme-radius.css",
    "./tailwindcss/theme-spacing.css": "./src/tailwindcss/theme-spacing.css",
    "./tailwindcss/theme-breakpoints.css": "./src/tailwindcss/theme-breakpoints.css",
    "./tailwindcss/theme-shadows.css": "./src/tailwindcss/theme-shadows.css",
    "./tailwindcss/theme-z-index.css": "./src/tailwindcss/theme-z-index.css",
    "./tailwindcss/theme-typography.css": "./src/tailwindcss/theme-typography.css",
    "./tailwindcss/theme-variants.css": "./src/tailwindcss/theme-variants.css",
    "./tailwindcss/utilities.css": "./src/tailwindcss/utilities.css",
    "./tailwindcss/tailwind.css": "./src/tailwindcss/tailwind.css",
    "./tailwindcss/*": {
      "types": "./dist/tailwindcss/*.d.ts",
      "import": "./dist/tailwindcss/*.js",
      "module": "./dist/tailwindcss/*.js",
      "default": "./dist/tailwindcss/*.js"
    },
    "./style.css": {
      "monorepo:dev": "./src/tailwindcss/tailwind.css",
      "default": "./dist/css/main.css"
    },
    "./aos.css": {
      "monorepo:dev": "./src/plugins/aos/scss/index.scss",
      "default": "./dist/css/aos.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "dist",
    "src/tailwindcss",
    "svg",
    "tailwindcss"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:fix": "pnpm lint:js:fix && pnpm lint:style:fix",
    "lint:js": "cross-env NODE_ENV=production eslint",
    "lint:js:fix": "pnpm lint:js --fix",
    "lint:style": "stylelint \"./**/*.{vue,css,scss,postcss,pcss,html}\"",
    "lint:style:fix": "pnpm lint:style --fix",
    "build": "vite build && pnpm generate:agent-docs",
    "build:watch": "vite build --watch --mode development",
    "build:analyze": "tsx build/analyze-bundle.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:coverage:watch": "vitest watch --coverage",
    "test:unit:coverage:master": "vitest run --coverage --changed master",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "generate:agent-docs": "pnpm -F agent-docs generate --package maz-ui"
  },
  "peerDependencies": {
    "arktype": ">=2.0.0 <3.0.0",
    "nuxt": ">=3.4.0 <5.0.0",
    "shiki": ">=4.0.0",
    "unplugin-auto-import": ">=19.0.0 <22.0.0",
    "unplugin-vue-components": ">=28.0.0 <33.0.0",
    "valibot": ">=1.0.0 <2.0.0",
    "vue": ">=3.5.0 <4.0.0",
    "vue-router": ">=4.0.0 <6.0.0",
    "zod": ">=3.24.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "unplugin-auto-import": {
      "optional": true
    },
    "unplugin-vue-components": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@maz-ui/icons": "workspace:^",
    "@maz-ui/themes": "workspace:^",
    "@maz-ui/translations": "workspace:^",
    "@maz-ui/utils": "workspace:^",
    "@tanstack/vue-virtual": "^3.13.52",
    "chart.js": "catalog:",
    "dayjs": "catalog:",
    "dompurify": "^3.4.17",
    "libphonenumber-js": "catalog:",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "catalog:",
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/node": "workspace:^",
    "@maz-ui/stylelint-config": "workspace:^",
    "@maz-ui/vite-config": "workspace:^",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "arktype": "^2.2.9",
    "autoprefixer": "^10.6.2",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "nuxt": "catalog:",
    "postcss": "catalog:",
    "postcss-nested": "catalog:",
    "sass": "^1.107.1",
    "shiki": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-svg-loader": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix",
    "*.{vue,css,scss,postcss,pcss}": "stylelint --fix --allow-empty-input"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/docs/src/**/*.md",
          "{workspaceRoot}/apps/docs/.vitepress/mixins/**/*",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/packages/maz-ui/src/**/*",
          "{workspaceRoot}/packages/icons/src/icon-list.ts",
          "{workspaceRoot}/packages/nuxt/src/module.ts",
          "{workspaceRoot}/packages/utils/src/**/*",
          "{workspaceRoot}/packages/node/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/agent-docs"
        ]
      }
    }
  }
}
