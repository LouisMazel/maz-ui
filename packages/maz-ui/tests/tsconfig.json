{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"],
      "@tests/*": ["./*"],
      "@components/*": ["../src/components/*"],
      "@composables/*": ["../src/composables/*"],
      "@directives/*": ["../src/directives/*"],
      "@plugins/*": ["../src/plugins/*"],
      "@resolvers/*": ["../src/resolvers/*"]
    },
    "types": ["node", "@maz-ui/vite-svg-loader/client", "vitest/globals", "vue"]
  },
  "include": ["**/*", "../src/**/*"]
}
