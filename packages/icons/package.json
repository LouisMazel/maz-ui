{
  "name": "@maz-ui/icons",
  "type": "module",
  "version": "5.7.0-beta.8",
  "description": "Icons set in SVG and Vue components",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "homepage": "https://maz-ui.com/ecosystem/icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/LouisMazel/maz-ui/issues"
  },
  "keywords": [
    "vue",
    "nuxt",
    "components",
    "vue-component",
    "framework",
    "library",
    "ui",
    "nuxt",
    "nuxt3",
    "module",
    "nuxt-module",
    "maz-ui",
    "icons",
    "svg"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/static/*.js",
        "default": "./dist/static/*.js"
      },
      "./static": {
        "types": "./dist/static/index.d.ts",
        "import": "./dist/static/index.js",
        "default": "./dist/static/index.js"
      },
      "./static/*": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/static/*.js",
        "default": "./dist/static/*.js"
      },
      "./lazy": {
        "types": "./dist/lazy/index.d.ts",
        "import": "./dist/lazy/index.js",
        "default": "./dist/lazy/index.js"
      },
      "./lazy/*": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/lazy/*.js",
        "default": "./dist/lazy/*.js"
      },
      "./raw": {
        "types": "./dist/raw/index.d.ts",
        "import": "./dist/raw/index.js",
        "default": "./dist/raw/index.js"
      },
      "./raw/*": {
        "types": "./dist/icons.d.ts",
        "import": "./dist/raw/*.js",
        "default": "./dist/raw/*.js"
      },
      "./resolvers": {
        "types": "./dist/resolvers.d.ts",
        "import": "./dist/resolvers.js",
        "default": "./dist/resolvers.js"
      },
      "./registry": {
        "types": "./dist/registry.d.ts",
        "import": "./dist/registry.js",
        "default": "./dist/registry.js"
      },
      "./icon-names.json": "./icon-names.json",
      "./package.json": "./package.json",
      "./icon-list": {
        "types": "./dist/icon-list.d.ts",
        "import": "./dist/icon-list.js",
        "default": "./dist/icon-list.js"
      },
      "./svg/*": "./svg/*"
    }
  },
  "exports": {
    ".": {
      "monorepo:dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "monorepo:dev": "./src/static/*.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/static/*.js",
      "default": "./dist/static/*.js"
    },
    "./static": {
      "monorepo:dev": "./src/static/index.ts",
      "types": "./dist/static/index.d.ts",
      "import": "./dist/static/index.js",
      "default": "./dist/static/index.js"
    },
    "./static/*": {
      "monorepo:dev": "./src/static/*.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/static/*.js",
      "default": "./dist/static/*.js"
    },
    "./lazy": {
      "monorepo:dev": "./src/lazy/index.ts",
      "types": "./dist/lazy/index.d.ts",
      "import": "./dist/lazy/index.js",
      "default": "./dist/lazy/index.js"
    },
    "./lazy/*": {
      "monorepo:dev": "./src/lazy/*.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/lazy/*.js",
      "default": "./dist/lazy/*.js"
    },
    "./raw": {
      "monorepo:dev": "./src/raw/index.ts",
      "types": "./dist/raw/index.d.ts",
      "import": "./dist/raw/index.js",
      "default": "./dist/raw/index.js"
    },
    "./raw/*": {
      "monorepo:dev": "./src/raw/*.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/raw/*.js",
      "default": "./dist/raw/*.js"
    },
    "./resolvers": {
      "monorepo:dev": "./src/resolvers.ts",
      "types": "./dist/resolvers.d.ts",
      "import": "./dist/resolvers.js",
      "default": "./dist/resolvers.js"
    },
    "./registry": {
      "monorepo:dev": "./src/registry.ts",
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./icon-names.json": "./icon-names.json",
    "./package.json": "./package.json",
    "./icon-list": {
      "monorepo:dev": "./src/icon-list.ts",
      "types": "./dist/icon-list.d.ts",
      "import": "./dist/icon-list.js",
      "default": "./dist/icon-list.js"
    },
    "./svg/*": "./svg/*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "dist",
    "icon-names.json",
    "svg"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "vite build && pnpm generate:agent-docs",
    "generate": "node utils/generate.ts",
    "generate:agent-docs": "pnpm -F agent-docs generate --package @maz-ui/icons",
    "typecheck": "pnpm generate && tsc --noEmit --skipLibCheck",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "pnpm generate && vitest run",
    "test:unit:watch": "pnpm generate && vitest watch",
    "test:unit:coverage": "pnpm generate && vitest run --coverage"
  },
  "peerDependencies": {
    "unplugin-vue-components": ">=28.0.0 <33.0.0",
    "vue": ">=3.5.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "unplugin-vue-components": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codecov/vite-plugin": "catalog:",
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/node": "workspace:^",
    "@maz-ui/utils": "workspace:^",
    "@maz-ui/vite-config": "workspace:^",
    "@maz-ui/vite-svg-loader": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/apps/docs/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/agent-docs",
          "{projectRoot}/icon-names.json",
          "{projectRoot}/src/index.ts",
          "{projectRoot}/src/icon-list.ts",
          "{projectRoot}/src/static",
          "{projectRoot}/src/lazy",
          "{projectRoot}/src/raw"
        ]
      }
    }
  }
}
