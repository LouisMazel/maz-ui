{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "rootDir": ".",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "vitest.config.ts",
    "eslint.config.ts",
    "**/tests/**/*",
    "**/*.test.*"
  ]
}
