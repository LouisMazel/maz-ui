{
  "name": "@maz-ui/mcp",
  "type": "module",
  "version": "5.1.1",
  "description": "MCP server and CLI that give AI coding agents the version-matched knowledge of maz-ui and its ecosystem: search, component APIs, icons, Tailwind theme tokens, setup guides and code review",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": "https://github.com/LouisMazel/maz-ui/issues",
  "keywords": [
    "maz-ui",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "claude",
    "cursor",
    "copilot",
    "vue",
    "nuxt",
    "tailwindcss"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "maz-ui-mcp": "./bin/maz-ui-mcp.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate:docs": "tsx ../../tools/agent-docs/src/cli.ts --out ./docs",
    "build": "pnpm generate:docs && unbuild",
    "build:watch": "pnpm generate:docs && unbuild --watch",
    "dev": "tsx scripts/dev.ts",
    "dev:inspector": "mcp-inspector tsx scripts/dev.ts",
    "preview": "node bin/maz-ui-mcp.mjs",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "pnpm generate:docs && vitest run",
    "test:unit:watch": "pnpm generate:docs && vitest watch",
    "test:unit:coverage": "pnpm generate:docs && vitest run --coverage"
  },
  "dependencies": {
    "@babel/parser": "^8.0.8",
    "@maz-ui/node": "workspace:*",
    "@maz-ui/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vue/compiler-dom": "^3.5.44",
    "minisearch": "^7.2.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/types": "^8.0.8",
    "@maz-ui/eslint-config": "workspace:*",
    "@modelcontextprotocol/inspector": "^2.11.0",
    "agent-docs": "workspace:*",
    "tsx": "^4.23.15",
    "unbuild": "^3.6.1"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/apps/docs/src/**/*.md",
          "{workspaceRoot}/apps/docs/.vitepress/mixins/**/*",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/packages/lib/src/**/*",
          "{workspaceRoot}/packages/icons/src/icon-list.ts",
          "{workspaceRoot}/packages/nuxt/src/module.ts",
          "{workspaceRoot}/packages/utils/src/**/*",
          "{workspaceRoot}/packages/node/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/docs"
        ]
      },
      "test:unit": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/apps/docs/src/**/*.md",
          "{workspaceRoot}/apps/docs/.vitepress/mixins/**/*",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/packages/lib/src/**/*",
          "{workspaceRoot}/packages/icons/src/icon-list.ts",
          "{workspaceRoot}/packages/nuxt/src/module.ts",
          "{workspaceRoot}/packages/utils/src/**/*",
          "{workspaceRoot}/packages/node/src/**/*"
        ]
      },
      "test:unit:coverage": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/apps/docs/src/**/*.md",
          "{workspaceRoot}/apps/docs/.vitepress/mixins/**/*",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/packages/lib/src/**/*",
          "{workspaceRoot}/packages/icons/src/icon-list.ts",
          "{workspaceRoot}/packages/nuxt/src/module.ts",
          "{workspaceRoot}/packages/utils/src/**/*",
          "{workspaceRoot}/packages/node/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/coverage"
        ]
      }
    }
  }
}
