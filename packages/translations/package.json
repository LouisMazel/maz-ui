{
  "name": "@maz-ui/translations",
  "type": "module",
  "version": "6.0.0-beta.0",
  "description": "Translations for Maz-UI library",
  "author": "Louis Mazel <me@loicmazuel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisMazel/maz-ui.git"
  },
  "bugs": "https://github.com/LouisMazel/maz-ui/issues",
  "keywords": [
    "translations",
    "i18n",
    "internationalization",
    "localization",
    "maz-ui",
    "vue",
    "nuxt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.mts",
        "import": "./dist/plugin.js",
        "default": "./dist/plugin.js"
      },
      "./utils": {
        "types": "./dist/utils/index.d.mts",
        "import": "./dist/utils/index.js",
        "default": "./dist/utils/index.js"
      },
      "./utils/*": {
        "types": "./dist/utils/*.d.mts",
        "import": "./dist/utils/*.js",
        "default": "./dist/utils/*.js"
      },
      "./locales": {
        "types": "./dist/locales/index.d.mts",
        "import": "./dist/locales/index.js",
        "default": "./dist/locales/index.js"
      },
      "./locales/*": {
        "types": "./dist/locales/*.d.mts",
        "import": "./dist/locales/*.js",
        "default": "./dist/locales/*.js"
      },
      "./composables": {
        "types": "./dist/composables/useTranslations.d.mts",
        "import": "./dist/composables/useTranslations.js",
        "default": "./dist/composables/useTranslations.js"
      },
      "./composables/*": {
        "types": "./dist/composables/*.d.mts",
        "import": "./dist/composables/*.js",
        "default": "./dist/composables/*.js"
      }
    }
  },
  "exports": {
    ".": {
      "monorepo:dev": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "monorepo:dev": "./src/plugin.ts",
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./utils": {
      "monorepo:dev": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/*": {
      "monorepo:dev": "./src/utils/*.ts",
      "types": "./dist/utils/*.d.mts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./locales": {
      "monorepo:dev": "./src/locales/index.ts",
      "types": "./dist/locales/index.d.mts",
      "import": "./dist/locales/index.js",
      "default": "./dist/locales/index.js"
    },
    "./locales/*": {
      "monorepo:dev": "./src/locales/*.ts",
      "types": "./dist/locales/*.d.mts",
      "import": "./dist/locales/*.js",
      "default": "./dist/locales/*.js"
    },
    "./composables": {
      "monorepo:dev": "./src/composables/useTranslations.ts",
      "types": "./dist/composables/useTranslations.d.mts",
      "import": "./dist/composables/useTranslations.js",
      "default": "./dist/composables/useTranslations.js"
    },
    "./composables/*": {
      "monorepo:dev": "./src/composables/*.ts",
      "types": "./dist/composables/*.d.mts",
      "import": "./dist/composables/*.js",
      "default": "./dist/composables/*.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "agent-docs",
    "dist"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "vite build && pnpm generate:agent-docs",
    "generate:agent-docs": "pnpm -F agent-docs generate --package @maz-ui/translations",
    "build:watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "check:published-types": "attw --pack . --profile esm-only",
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4.0.0"
  },
  "dependencies": {
    "@maz-ui/utils": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@codecov/vite-plugin": "catalog:",
    "@maz-ui/eslint-config": "workspace:^",
    "@maz-ui/vite-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "glob": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,md,yml,json}": [
      "eslint --fix"
    ]
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/agent-docs/src/**/*",
          "{workspaceRoot}/tools/agent-docs/content/**/*",
          "{workspaceRoot}/apps/docs/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/agent-docs"
        ]
      }
    }
  }
}
