{
  "mcpServers": {
    "maz-ui": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "pnpm nx run @maz-ui/mcp:build >&2 && exec pnpm exec @maz-ui/mcp"
      ]
    },
    "relizy": {
      "type": "stdio",
      "command": "pnpm",
      "args": [
        "exec",
        "relizy",
        "mcp"
      ]
    }
  }
}
