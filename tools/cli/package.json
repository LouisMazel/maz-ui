{
  "name": "cli",
  "type": "module",
  "version": "4.1.8-beta.1",
  "private": true,
  "exports": {
    ".": "./dist/cli.mjs",
    "./cli": "./bin/cli.mjs",
    "./types": "./dist/cli.d.ts"
  },
  "main": "./dist/cli.mjs",
  "types": "./dist/cli.d.ts",
  "bin": {
    "cli": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "lint": "cross-env NODE_ENV=production eslint .",
    "lint:fix": "pnpm lint --fix",
    "cli": "tsx src/cli.ts",
    "build": "unbuild",
    "build:stub": "unbuild --stub",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@maz-ui/node": "workspace:^",
    "@maz-ui/utils": "workspace:^",
    "colorette": "catalog:",
    "commander": "catalog:",
    "figlet": "catalog:"
  },
  "devDependencies": {
    "@maz-ui/eslint-config": "workspace:^",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,cjs,md,yml,json}": "cross-env NODE_ENV=production eslint --fix"
  }
}
